{
  "name": "lobster-desk",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web"],
  "scripts": {
    "setup:agents": "node scripts/agents.mjs --setup",
    "agents:check": "node scripts/agents.mjs --check",
    "agents": "node scripts/agents.mjs",
    "execution": "node scripts/execution.mjs",
    "treasury": "node scripts/python.mjs scripts/treasury-runner.py",
    "users:execution": "node scripts/python.mjs scripts/user-runner.py",
    "revenue": "node scripts/python.mjs scripts/revenue-runner.py",
    "authors:payouts": "node scripts/python.mjs scripts/author-payout-runner.py",
    "ops": "node scripts/python.mjs scripts/ops-runner.py",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @lobster/web",
    "build": "npm run build --workspace @lobster/web",
    "typecheck": "npm run typecheck --workspace @lobster/web",
    "test:api": "node scripts/python.mjs -m pytest apps/api/tests -q",
    "test:web": "node --experimental-strip-types --test apps/web/tests/*.test.mjs"
  },
  "engines": { "node": ">=22" }
}

