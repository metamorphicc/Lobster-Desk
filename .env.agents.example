# Autonomous PAPER research. Copy with npm run setup:agents; never commit .env.agents.
# Fill in the key below, then run npm run agents:check and npm run agents.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_PROVIDER=anthropic
RESEARCH_ENABLED=true
MARKET_SOURCE=hyperliquid
DATABASE_URL=sqlite:///data/agents-paper.db
INITIAL_CAPITAL=1000
WORKER_ENABLED=true
RESEARCH_HISTORY_BARS=1440
RESEARCH_INTERVAL_SECONDS=86400
MAX_RESEARCH_CALLS_PER_DAY=4
MAX_REVIEW_CALLS_PER_DAY=100
MARKET_POLL_SECONDS=5
REVIEW_INTERVAL_SECONDS=2
TREASURY_PATH=data/treasury.sqlite3
USER_TESTNET_BUILDER_FEE_TENTHS_BPS=50
# No wallet keys. No live order, fee collection, donation or burn activation.
