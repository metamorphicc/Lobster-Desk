# Copy to .env at repository root. Never commit .env.
DATABASE_URL=sqlite:///data/lobster.db
INITIAL_CAPITAL=1000

# demo = explicitly synthetic market. hyperliquid = read-only public mainnet data.
# Changing the feed with an open position is unsupported; close it first.
MARKET_SOURCE=demo

# demo = scripted reviewers, not AI. anthropic = real hosted model reviews.
AGENT_PROVIDER=demo
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Optional: at least 24 characters. Controls stay disabled until configured.
# OPERATOR_TOKEN=

MARKET_POLL_SECONDS=5
REVIEW_INTERVAL_SECONDS=2
MAX_REVIEW_CALLS_PER_DAY=100

# Optional autonomous research; default off. For key-only paper setup use
# npm run setup:agents, fill .env.agents, then npm run agents.
RESEARCH_ENABLED=false
RESEARCH_INTERVAL_SECONDS=86400
RESEARCH_HISTORY_BARS=1440
MAX_RESEARCH_CALLS_PER_DAY=4
TREASURY_PATH=data/treasury.sqlite3
PAPER_FUNDING_ENABLED=true

# Optional read-only testnet workbench. Public addresses only; no private key here.
# HL_TESTNET_ACCOUNT_ADDRESS=
# HL_TESTNET_API_WALLET_ADDRESS=
HL_TESTNET_DATABASE_URL=sqlite:///data/testnet.db
HL_TESTNET_MAX_ENTRY_NOTIONAL=50

# To review testnet-market setups while keeping execution simulated:
# MARKET_SOURCE=hyperliquid-testnet
# DATABASE_URL=sqlite:///data/testnet-paper.db
# The separate testnet signer reads .env.testnet-signer, not this file.

# User-owned account inspection, independent of the tank's execution account.
# Optional public builder address. Collection and order submission stay disabled.
# USER_TESTNET_BUILDER_ADDRESS=
USER_TESTNET_BUILDER_FEE_TENTHS_BPS=50

# Separate explicit financial testnet proof queue. The API still holds no user keys.
USER_TESTNET_FINANCIAL_ENABLED=false
USER_TESTNET_EXECUTION_ROOT=data/users-financial

# Separate mainnet user permissions (off by default). Use a distinct API wallet.
# USER_MAINNET_BUILDER_ADDRESS=
USER_MAINNET_BUILDER_FEE_TENTHS_BPS=50
USER_MAINNET_FINANCIAL_ENABLED=false
USER_MAINNET_EXECUTION_ROOT=data/users-mainnet
