# Separate owner-enabled process. The API server never reads this file.
AUTHOR_PAYOUT_ENABLED=false
# Dedicated PROJECT MAIN account address/key, not a user wallet or trading API key.
# A transfer-capable key is needed for USD sends; keep project capital bounded.
# AUTHOR_PAYOUT_ACCOUNT=
# AUTHOR_PAYOUT_PRIVATE_KEY=
AUTHOR_PAYOUT_BOOK=data/treasury.sqlite3
AUTHOR_PAYOUT_BATCH_USDC=25
# Explicit reserves required before --run --arm; no guessed spending mandate.
# AUTHOR_PAYOUT_OPERATING_RESERVE=
# AUTHOR_PAYOUT_LIABILITY_RESERVE=
# AUTHOR_PAYOUT_TAX_RESERVE=
