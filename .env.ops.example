# AES-256-GCM key as exactly 64 hexadecimal characters. Keep a separate recovery copy.
OPS_ENCRYPTION_KEY=
OPS_OFFSITE_ENABLED=false
OPS_S3_BUCKET=
OPS_S3_REGION=us-east-1
OPS_S3_PREFIX=lobster-backups
OPS_AWS_ACCESS_KEY_ID=
OPS_AWS_SECRET_ACCESS_KEY=
OPS_AWS_SESSION_TOKEN=
# Explicit opt-in to AWS SDK instance-role credential discovery instead of static keys.
OPS_USE_INSTANCE_ROLE=false
# Notifications are separate from backup uploads and default to off.
OPS_ALERTS_ENABLED=false
OPS_ALERT_WEBHOOK=
OPS_ALERT_WEBHOOK_SECRET=
OPS_ALERT_FORMAT=generic
OPS_STATE_PATH=data/operations.sqlite3
OPS_APPLICATION_PATH=data/lobster.db
OPS_TREASURY_PATH=data/treasury.sqlite3
# Only needed when probing a public-single-host API through its internal boundary.
OPS_PROXY_TOKEN=
