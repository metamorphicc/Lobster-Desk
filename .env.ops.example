# AES-256-GCM key as exactly 64 hexadecimal characters. Keep a separate recovery copy.
OPS_ENCRYPTION_KEY=
OPS_OFFSITE_ENABLED=false
OPS_S3_BUCKET=
OPS_S3_REGION=us-east-1
OPS_S3_PREFIX=lobster-backups
OPS_AWS_ACCESS_KEY_ID=
OPS_AWS_SECRET_ACCESS_KEY=
OPS_AWS_SESSION_TOKEN=
# Explicit opt-in to AWS SDK instance-role credential discovery instead of static keys.
OPS_USE_INSTANCE_ROLE=false
