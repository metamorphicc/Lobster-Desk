# USDC (ERC-20), Ethereum only. Independent of the project's Solana token.
CHARITY_ENABLED=false
CHARITY_OWNER=
# Dedicated Ethereum treasury signer, not a user/API wallet.
CHARITY_PRIVATE_KEY=
# Partner API credentials issued by The Giving Block; never exposed to browsers.
CHARITY_TGB_LOGIN=
CHARITY_TGB_PASSWORD=
CHARITY_BOOK=data/treasury.sqlite3
# Required exact USDC reserves, consistent with the treasury policy.
CHARITY_OPERATING_RESERVE=
CHARITY_LIABILITY_RESERVE=
CHARITY_TAX_RESERVE=
CHARITY_BATCH_USDC=25
CHARITY_MAX_GAS_PRICE_WEI=20000000000
CHARITY_ETH_RESERVE_WEI=1000000000000000
