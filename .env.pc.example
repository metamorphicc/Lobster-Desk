# PC-only API behind an owner-started HTTPS tunnel. Keep .env.pc private.
DEPLOYMENT_MODE=public-single-host
# Exact Vercel production origin, e.g. https://your-project.vercel.app (no slash).
WEB_ORIGIN=
# Generated locally by npm run setup:pc. Copy only PROXY_TOKEN to Vercel.
PROXY_TOKEN=
OPERATOR_TOKEN=
DATABASE_URL=sqlite:///data/pc-paper.db
TREASURY_PATH=data/treasury.sqlite3
MARKET_SOURCE=hyperliquid
WORKER_ENABLED=true
PAPER_FUNDING_ENABLED=true
AGENT_PROVIDER=demo
RESEARCH_ENABLED=false
# For paid model research later, fill these locally and explicitly change the
# provider to anthropic / research to true. This does not enable real orders.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
