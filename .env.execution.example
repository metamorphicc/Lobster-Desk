# Separate project executor. Never commit .env.execution or use an owner main key.
PROJECT_NETWORK=testnet
PROJECT_ENABLED=false
# PROJECT_ACCOUNT=
# PROJECT_AGENT=
# PROJECT_PRIVATE_KEY=
PROJECT_DATABASE_URL=sqlite:///data/project-testnet.sqlite3
PROJECT_MAX_ENTRY_NOTIONAL=50
# Explicit limits are required before --run --arm. No guessed capital mandate.
# PROJECT_CAPITAL_BUDGET=
# PROJECT_ABSOLUTE_LOSS_BUDGET=
# PROJECT_RESERVE_FLOOR=
# For mainnet: use a NEW journal, PROJECT_NETWORK=mainnet and a dedicated
# approved mainnet API wallet. The application feed must be hyperliquid.
# Optional observed mainnet settlements. Same path as the application's TREASURY_PATH.
# PROJECT_TREASURY_PATH=data/treasury.sqlite3
