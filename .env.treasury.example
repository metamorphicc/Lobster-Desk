# Separate Solana treasury process. This file never activates financial operations.
SOLANA_ENABLED=false
# Base58 Solana public keys. Mint must use the classic SPL Token program.
SOLANA_OWNER=
SOLANA_MINT=
# Dedicated treasury keypair as base58 64-byte secret; never use the Hyperliquid API key.
SOLANA_PRIVATE_KEY=
SOLANA_JUPITER_API_KEY=
SOLANA_BOOK=data/treasury.sqlite3
# Required exact USDC amounts. Blank means no spendable budget.
SOLANA_OPERATING_RESERVE=
SOLANA_LIABILITY_RESERVE=
SOLANA_TAX_RESERVE=
SOLANA_MAX_BUYBACK_USDC=25
SOLANA_SLIPPAGE_BPS=50
SOLANA_SOL_RESERVE_LAMPORTS=10000000
SOLANA_MAX_TRANSACTION_FEE_LAMPORTS=20000
